.tab-slot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 10px 16px calc(env(safe-area-inset-bottom) + 14px);
  background: var(--bg, #F2F2F7);
  box-sizing: border-box;
}
.tab-slot.hide-m { display: none; }
.tab-slot .tabbar {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  width: 100%;
  max-width: 528px;
  margin: 0 auto;
}
.tabbar .tab {
  position: relative;
  flex: 1;
  height: 54px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: var(--tab, #6C6C70);
  font-size: 10px;
  font-weight: 500;
}
.tabbar .tab.on { color: var(--ink, #D0402B); font-weight: 600; }
.tabbar .tab.write {
  flex: none;
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background: var(--ink, #D0402B);
  color: var(--on-ink, #FFFFFF);
  margin: 0 6px;
}
.tabbar .nav {
  flex: 1;
  display: flex;
  align-items: center;
  height: 100%;
}
