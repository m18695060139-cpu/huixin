<view class="screen">
  <st-nav title="对比说法" close="{{true}}" bind:close="onBack"></st-nav>
  <view class="page" style="padding: 24rpx 32rpx 80rpx;">
    <text class="note">用虚构样本比较现在线上的说法和新说法。不会改你的信、待办、点子或周信。需要已打开智能回信。</text>
    <view class="row" wx:for="{{cases}}" wx:key="id" data-id="{{item.id}}" bindtap="onPick">
      <text>{{item.name}}</text>
      <text wx:if="{{busy && current === item.id}}">正在写…</text>
    </view>
    <text class="err" wx:if="{{error}}">{{error}}</text>
    <view wx:if="{{oldText || newText}}">
      <text class="h">现在线上</text>
      <text class="body">{{oldText}}</text>
      <text class="h">新说法</text>
      <text class="body">{{newText}}</text>
    </view>
  </view>
</view>
