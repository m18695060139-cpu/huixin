.theme-opt.on { border-color: var(--ink); font-weight: 600; }
.swatch .bar { height: 4px; border-radius: 2px; display: block; }
.field { align-items: stretch; }
.opt { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 10px 14px; }
.opt + .opt { border-top: 0.5px solid var(--sep); }
.opt-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.opt-sub { font-size: 12px; color: var(--sub); line-height: 1.4; }
.tick-mark { color: var(--ink); font-size: 18px; font-weight: 700; flex: none; }
