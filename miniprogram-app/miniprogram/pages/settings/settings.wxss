.theme-opt.on { border-color: var(--ink); font-weight: 600; }
.swatch .bar { height: 7.692rpx; border-radius: 3.846rpx; display: block; }
.field { align-items: stretch; }
.opt { display: flex; align-items: center; gap: 23.077rpx; min-height: 100rpx; padding: 0 26.923rpx; }
.theme-opt text { text-align: center; display: block; width: 100%; }
.tick-mark { width: 34.615rpx; height: 34.615rpx; background-color: var(--ink); }
.opt + .opt { border-top: 0.962rpx solid var(--sep); }
.opt-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3.846rpx; }
.opt-sub { font-size: 23.077rpx; color: var(--sub); line-height: 1.4; }
.tick-mark { color: var(--ink); font-size: 34.615rpx; font-weight: 700; flex: none; }
