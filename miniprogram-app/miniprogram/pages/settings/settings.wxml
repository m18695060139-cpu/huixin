<view class="screen theme-{{theme}}" style="--safe-top: {{statusBar}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="subpage-bar sheet-bar" style="padding-top: {{statusBar}}px;">
    <view>
      <view class="sp"></view>
      <text class="t">设置</text>
      <button class="x" hover-class="tap-on" bindtap="back" aria-label="关闭"><view class="i i-x"></view></button>
    </view>
  </view>
  <view class="page" style="padding-top: {{statusBar + 58}}px; padding-bottom: calc(env(safe-area-inset-bottom) + 40px);">
    <view class="offline" wx:if="{{!online}}">云端还没连上 · 先存在这台手机</view>
    <view class="field">
      <text class="lab">回信怎么称呼你</text>
      <input class="input" value="{{name}}" bindblur="onName" maxlength="20" placeholder="比如：非云" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="lab">回信什么时候送到</text>
      <view class="group opts">
        <view class="opt" data-v="morning" bindtap="onDeliver">
          <view class="opt-main">
            <text>明早 6:00 拆信</text>
            <text class="opt-sub">今晚寄出的信，回信封存到第二天早上；补写的信马上送到</text>
          </view>
          <view class="i i-check tick-mark" wx:if="{{deliver !== 'now'}}"></view>
        </view>
        <view class="opt" data-v="now" bindtap="onDeliver">
          <view class="opt-main">
            <text>寄出后马上</text>
            <text class="opt-sub">写完就能看到回信</text>
          </view>
          <view class="i i-check tick-mark" wx:if="{{deliver === 'now'}}"></view>
        </view>
      </view>
    </view>
    <view class="field" wx:if="{{aiOn}}">
      <text class="lab">AI 回信</text>
      <view class="group">
        <view class="row">
          <view class="row-main">
            <text class="row-t">正在用微信云开发的混元 hy3</text>
            <text class="sub">回信、周信、季信和年信都由它来写。个人主体只能在体验版里用，不需要自己的 API Key。</text>
          </view>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="lab">外观</text>
      <view class="themes">
        <button wx:for="{{themes}}" wx:key="id" class="theme-opt {{item.on ? 'on' : ''}}" hover-class="tap-on" data-id="{{item.id}}" bindtap="onTheme">
          <view class="swatch" style="background: {{item.auto ? 'linear-gradient(90deg,#F2F2F7 50%,#000 50%)' : item.sw[0]}};">
            <view class="bar" style="background: {{item.sw[2]}}; width: 60%;"></view>
            <view class="bar" style="background: {{item.sw[1]}}; width: 85%;"></view>
          </view>
          <text>{{item.name}}</text>
        </button>
      </view>
    </view>
    <view class="field">
      <text class="lab">写信时顺手打卡的习惯</text>
      <view class="group">
        <view wx:if="{{!habits.length}}" class="empty">还没有习惯</view>
        <view class="row" wx:for="{{habits}}" wx:key="id">
          <input class="input" style="background:none;padding:0;min-height:92.308rpx;" value="{{item.name}}" data-id="{{item.id}}" bindblur="onRename" maxlength="30" />
          <button class="lk" hover-class="tap-on" style="color:var(--danger);" data-id="{{item.id}}" bindtap="onDelHabit">删除</button>
        </view>
      </view>
      <view style="display:flex;gap:15.385rpx;margin-top:15.385rpx;">
        <input class="input" value="{{habitName}}" bindinput="onHabitName" maxlength="30" placeholder="新习惯，比如：运动 30 分钟" placeholder-class="ph" />
        <button class="btn sm" hover-class="tap-on" style="height:92.308rpx;" bindtap="onAddHabit">添加</button>
      </view>
    </view>
    <view class="field">
      <text class="lab">回信写信时会想着的问题（一行一个）</text>
      <textarea class="input" value="{{qText}}" bindinput="onQ" maxlength="1200" auto-height="true" placeholder-class="ph" />
      <button class="btn sm ghost" hover-class="tap-on" style="align-self:flex-start;" bindtap="onSaveQ">保存问题</button>
    </view>
    <view class="field">
      <text class="lab">账号</text>
      <view class="group">
        <view class="row">
          <view class="row-main">
            <text class="row-t">微信登录</text>
            <text class="sub">内容只给你自己看，没有另外的账号密码</text>
          </view>
        </view>
        <view class="row" bindtap="goPrivacy">
          <text class="row-main"><text class="row-t">用户隐私保护指引</text></text>
          <text class="chev">›</text>
        </view>
        <view class="row" bindtap="onImport">
          <text class="row-main"><text class="row-t">从网页版导入 JSON</text></text>
          <text class="chev">›</text>
        </view>
      </view>
      <button class="btn ghost" hover-class="tap-on" style="margin-top:23.077rpx;" bindtap="onWipe">清空我的全部数据</button>
      <button class="btn ghost" hover-class="tap-on" style="margin-top:23.077rpx;" bindtap="onSeed">载入示例数据</button>
      <button class="btn ghost" hover-class="tap-on" style="margin-top:23.077rpx;" bindtap="onClearDemo">清除示例数据</button>
      <text class="note">示例数据和网页版演示账号同一套：信、回信、待办、点子、习惯、周信和季信。写进你自己的云数据库，并标上 demo。清除时只删这些。</text>
    </view>
    <text class="note" style="margin-top:76.923rpx;text-align:center;">回信 Re: · 今晚写给明早的自己</text>
  </view>
  <toast id="toast" />
</view>
