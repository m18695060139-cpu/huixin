<view class="screen theme-{{theme}}" style="--safe-top: {{statusBar}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="subpage-bar sheet-bar">
    <view>
      <view class="sp"></view>
      <text class="t">设置</text>
      <button class="x" hover-class="none" bindtap="back" aria-label="关闭">×</button>
    </view>
  </view>
  <view class="page" style="padding-top: 8px;">
    <view class="offline" wx:if="{{!online}}">云端还没连上 · 先存在这台手机</view>
    <view class="field">
      <text class="lab">回信怎么称呼你</text>
      <input class="input" value="{{name}}" bindblur="onName" maxlength="20" placeholder="比如：非云" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="lab">回信什么时候送到</text>
      <view class="group opts">
        <view class="opt" data-v="morning" bindtap="onDeliver">
          <view class="opt-main">
            <text>明早 6:00 拆信</text>
            <text class="opt-sub">今晚寄出的信，封到第二天早上；补写的信马上可以回看</text>
          </view>
          <text class="tick-mark" wx:if="{{deliver !== 'now'}}">✓</text>
        </view>
        <view class="opt" data-v="now" bindtap="onDeliver">
          <view class="opt-main">
            <text>寄出后马上</text>
            <text class="opt-sub">写完就能看到这封信</text>
          </view>
          <text class="tick-mark" wx:if="{{deliver === 'now'}}">✓</text>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="lab">外观</text>
      <view class="themes">
        <button wx:for="{{themes}}" wx:key="id" class="theme-opt {{item.on ? 'on' : ''}}" hover-class="none" data-id="{{item.id}}" bindtap="onTheme">
          <view class="swatch" style="background: {{item.auto ? 'linear-gradient(90deg,#F2F2F7 50%,#000 50%)' : item.sw[0]}};">
            <view class="bar" style="background: {{item.sw[2]}}; width: 60%;"></view>
            <view class="bar" style="background: {{item.sw[1]}}; width: 85%;"></view>
          </view>
          <text>{{item.name}}</text>
        </button>
      </view>
    </view>
    <view class="field">
      <text class="lab">写信时顺手打卡的习惯</text>
      <view class="group">
        <view wx:if="{{!habits.length}}" class="empty">还没有习惯</view>
        <view class="row" wx:for="{{habits}}" wx:key="id">
          <input class="input" style="background:none;padding:0;min-height:48px;" value="{{item.name}}" data-id="{{item.id}}" bindblur="onRename" maxlength="30" />
          <button class="lk" hover-class="none" style="color:var(--danger);" data-id="{{item.id}}" bindtap="onDelHabit">删除</button>
        </view>
      </view>
      <view style="display:flex;gap:8px;margin-top:8px;">
        <input class="input" value="{{habitName}}" bindinput="onHabitName" maxlength="30" placeholder="新习惯，比如：运动 30 分钟" placeholder-class="ph" />
        <button class="btn sm" hover-class="none" style="height:48px;" bindtap="onAddHabit">添加</button>
      </view>
    </view>
    <view class="field">
      <text class="lab">回信写信时会想着的问题（一行一个）</text>
      <textarea class="input" value="{{qText}}" bindinput="onQ" maxlength="1200" auto-height="true" placeholder-class="ph" />
      <button class="btn sm ghost" hover-class="none" style="align-self:flex-start;" bindtap="onSaveQ">保存问题</button>
    </view>
    <view class="field">
      <text class="lab">账号</text>
      <view class="group">
        <view class="row">
          <view class="row-main">
            <text class="row-t">微信登录</text>
            <text class="sub">内容只给你自己看，没有另外的账号密码</text>
          </view>
        </view>
        <view class="row" bindtap="goPrivacy">
          <text class="row-main"><text class="row-t">用户隐私保护指引</text></text>
          <text class="chev">›</text>
        </view>
        <view class="row" bindtap="onImport">
          <text class="row-main"><text class="row-t">从网页版导入 JSON</text></text>
          <text class="chev">›</text>
        </view>
      </view>
      <button class="btn ghost" hover-class="none" style="margin-top:12px;" bindtap="onWipe">清空我的全部数据</button>
    </view>
    <text class="note" style="margin-top:40px;text-align:center;">回信 Re: · 今晚写给明早的自己</text>
  </view>
  <toast id="toast" />
</view>
