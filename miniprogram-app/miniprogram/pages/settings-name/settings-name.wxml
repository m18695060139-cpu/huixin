<view class="screen theme-{{theme}}" style="--safe-top: {{statusBar}}px; --safe-bottom: {{safeBottom}}px;">
  <st-nav title="称呼" back="设置" bind:back="back"></st-nav>
  <view class="page st-page" style="padding-top: {{navBar}}px; padding-bottom: calc(env(safe-area-inset-bottom) + 40px);">
    <view class="st-sec">
      <view class="st-group">
        <view class="st-row">
          <view class="st-body">
            <text class="st-t">称呼</text>
            <input class="st-in" value="{{name}}" bindinput="onInput" bindblur="onBlur" maxlength="20" placeholder="比如：非云" placeholder-class="ph" adjust-position="{{true}}" cursor-spacing="120" disable-default-padding="{{true}}" confirm-type="done" />
          </view>
        </view>
      </view>
      <text class="st-foot">回信怎么称呼你</text>
    </view>
  </view>
  <toast id="toast" />
</view>
