.reply-p {
  display: block;
  margin: 0 0 14px;
  font-family: var(--letter-font);
  font-size: 16px;
  line-height: 1.95;
}
.reply-sign text { font-size: 12px; color: var(--sub); }
.sign-b { font-size: 14px; color: var(--ink); font-weight: 700; }
.mine-body { padding: 0 16px 16px; font-size: 15px; line-height: 1.85; color: var(--sub); }
.lens-k { display: block; font-size: 13px; font-weight: 600; color: var(--sub); }
.lens-v { display: block; font-size: 15px; line-height: 1.5; }
.fail-card { display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.6; }
.ic.gray { background: #8E8E93; }
