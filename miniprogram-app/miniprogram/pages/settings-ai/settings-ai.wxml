<view class="screen theme-{{theme}}" style="--safe-top: {{statusBar}}px; --safe-bottom: {{safeBottom}}px;">
  <st-nav title="智能回信" back="设置" bind:back="back"></st-nav>
  <view class="page st-page" style="padding-top: {{navBar}}px; padding-bottom: calc(env(safe-area-inset-bottom) + 80px);">

    <view class="st-sec">
      <view class="st-group">
        <view class="st-row">
          <view class="st-body">
            <text class="st-t st-grow">智能回信</text>
            <switch class="st-switch" checked="{{aiOn}}" color="#34C759" bindchange="onToggle" aria-label="智能回信" />
          </view>
        </view>
      </view>
      <text class="st-foot">打开后，寄出的信会交给 AI（腾讯混元，经微信云开发调用）写一封回信，并整理出待办和点子；每周一早上送一封周信。内容由 AI 生成，仅供参考。生成前后都会做内容安全检查。默认关闭，随时可以关掉。</text>
    </view>

    <block wx:if="{{aiOn}}">

    <view class="st-sec">
      <view class="st-group">
        <view class="st-row" wx:if="{{ai.loading}}">
          <view class="st-body"><text class="st-empty">读取中…</text></view>
        </view>
        <view class="st-row" wx:elif="{{ai.configured}}">
          <view class="st-body">
            <view class="st-main">
              <text class="st-t st-grow st-wrap">正在用你自己的 <text class="st-em">{{ai.providerName}}</text></text>
              <text class="st-sub">{{ai.model}} · Key 尾号 {{ai.last4}}</text>
            </view>
          </view>
        </view>
        <view class="st-row" wx:else>
          <view class="st-body">
            <view class="st-main">
              <text class="st-t st-grow st-wrap">正在用 <text class="st-em">微信云开发的混元</text></text>
              <text class="st-sub">不用花钱，但每天有额度上限。</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="st-sec" wx:if="{{!ai.loading}}">
      <text class="st-head">服务商</text>
      <view class="st-group">
        <view class="st-row" wx:for="{{ai.providers}}" wx:key="id" hover-class="st-hover" data-id="{{item.id}}" bindtap="onProvider">
          <view class="st-body">
            <text class="st-t st-grow st-wrap">{{item.name}}</text>
            <text class="st-pending" wx:if="{{item.pending}}">将使用</text>
            <view class="i i-check st-tick" wx:if="{{item.on}}"></view>
          </view>
        </view>
      </view>
      <text class="st-foot">{{aiHelp}}</text>
    </view>

    <view class="st-sec" wx:if="{{!ai.loading && ai.showForm}}">
      <view class="st-group">
        <view class="st-row">
          <view class="st-body st-col">
            <text class="st-lab">接口地址</text>
            <input class="st-in st-left" value="{{ai.form.base_url}}" placeholder="https://…/v1" placeholder-class="ph" data-k="base_url" bindinput="onField" maxlength="200" adjust-position="{{true}}" cursor-spacing="160" disable-default-padding="{{true}}" confirm-type="done" />
          </view>
        </view>
        <view class="st-row">
          <view class="st-body st-col">
            <text class="st-lab">模型名</text>
            <input class="st-in st-left" value="{{ai.form.model}}" placeholder="比如 deepseek-chat" placeholder-class="ph" data-k="model" bindinput="onField" maxlength="120" adjust-position="{{true}}" cursor-spacing="160" disable-default-padding="{{true}}" confirm-type="done" />
          </view>
        </view>
        <view class="st-row">
          <view class="st-body st-col">
            <text class="st-lab">API Key</text>
            <input class="st-in st-left" value="{{ai.form.key}}" password="{{true}}" placeholder="{{ai.keyPlaceholder}}" placeholder-class="ph" data-k="key" bindinput="onField" maxlength="200" adjust-position="{{true}}" cursor-spacing="160" disable-default-padding="{{true}}" confirm-type="done" />
          </view>
        </view>
      </view>
    </view>

    <view class="st-sec" wx:if="{{!ai.loading && ai.showForm}}">
      <view class="st-group">
        <view class="st-row {{ai.busy ? 'st-busy' : ''}}" hover-class="st-hover" bindtap="onTest">
          <view class="st-body"><text class="st-t st-accent st-grow">{{ai.busy === 'test' ? '测试中…' : '测试一下'}}</text></view>
        </view>
        <view class="st-row {{ai.busy ? 'st-busy' : ''}}" hover-class="st-hover" bindtap="onSave">
          <view class="st-body"><text class="st-t st-accent st-grow">{{ai.busy === 'save' ? '保存中…' : '保存'}}</text></view>
        </view>
      </view>
      <text class="st-foot {{ai.ok ? '' : 'st-danger'}}" wx:if="{{ai.msg}}">{{ai.msg}}</text>
    </view>

    <view class="st-sec" wx:if="{{ai.configured && !ai.loading}}">
      <view class="st-group">
        <view class="st-row" hover-class="st-hover" bindtap="onOff">
          <view class="st-body"><text class="st-t st-danger st-grow">停用，改回免费模型</text></view>
        </view>
      </view>
    </view>

    <view class="st-sec">
      <text class="st-foot">回信内容有问题，可以在回信底部点「举报」，或在「设置 → 意见反馈与投诉」告诉我们。</text>
    </view>
    </block>

  </view>
  <toast id="toast" />
</view>
