// 写信页下拉 / 左缘右滑关闭。手指移动用 setStyle，不 setData。
// 模块级变量在 tab 页生命周期里不会丢，关闭后必须靠 onReset / data-tok 清掉。
var startX = 0;
var startY = 0;
var lastX = 0;
var lastY = 0;
var lastT = 0;
var moving = false;
var ignored = false;
var closing = false;
var mode = '';
var appliedTok = '';
var EDGE = 32;

function num(v, d) {
  var n = parseFloat(v);
  return isNaN(n) ? d : n;
}

function now() {
  return getDate().getTime();
}

function isOn(v) {
  return v === true || v === 'true' || v === 1 || v === '1';
}

function applyReset(ins) {
  closing = false;
  moving = false;
  ignored = false;
  mode = '';
  if (ins && ins.setStyle) {
    ins.setStyle({
      'transform': 'translate3d(0,0,0)',
      'transition': 'none'
    });
  }
}

function onReset(newVal, oldVal, owner, ins) {
  appliedTok = newVal;
  applyReset(ins);
}

function maybeReset(ds, ins) {
  if (!ds) return;
  var tok = ds.tok;
  if (tok != null && tok !== '' && ('' + tok) !== ('' + appliedTok)) {
    appliedTok = tok;
    applyReset(ins);
  }
}

function touchStart(e, ins) {
  maybeReset(e.currentTarget.dataset, ins);
  if (closing) return;
  var ds = e.currentTarget.dataset;
  if (!isOn(ds.on)) {
    ignored = true;
    return;
  }
  var t = e.touches[0];
  if (!t) { ignored = true; return; }
  startX = t.clientX;
  startY = t.clientY;
  lastX = startX;
  lastY = startY;
  lastT = now();
  moving = false;
  ignored = false;
  mode = '';
  ins.setStyle({ 'transition': 'none' });
}

function inZone(ds) {
  var head = num(ds.head, 90);
  var h = num(ds.h, 667);
  if (startY >= (h - 140)) return false;
  if (startY <= head) return true;
  if (startX <= EDGE) return true;
  if (isOn(ds.attop)) return true;
  return false;
}

function touchMove(e, ins) {
  if (ignored || closing) return;
  var t = e.touches[0];
  if (!t) return;
  var x = t.clientX;
  var y = t.clientY;
  var dx = x - startX;
  var dy = y - startY;
  if (!moving) {
    if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
    if (!inZone(e.currentTarget.dataset)) {
      ignored = true;
      return;
    }
    if (dy > 0 && dy >= Math.abs(dx)) {
      mode = 'down';
      moving = true;
      ins.callMethod('onSheetDragStart');
    } else if (dx > 0 && startX <= EDGE && dx >= Math.abs(dy)) {
      mode = 'right';
      moving = true;
      ins.callMethod('onSheetDragStart');
    } else {
      ignored = true;
      return;
    }
  }
  lastX = x;
  lastY = y;
  lastT = now();
  if (mode === 'down') {
    if (dy < 0) dy = 0;
    ins.setStyle({
      'transform': 'translate3d(0,' + dy + 'px,0)',
      'transition': 'none'
    });
  } else {
    if (dx < 0) dx = 0;
    ins.setStyle({
      'transform': 'translate3d(' + dx + 'px,0,0)',
      'transition': 'none'
    });
  }
  return false;
}

function touchEnd(e, ins) {
  if (ignored || closing || !moving) {
    ignored = false;
    moving = false;
    return;
  }
  var ds = e.currentTarget.dataset;
  var h = num(ds.h, 667);
  var w = num(ds.w, 390);
  var t = (e.changedTouches && e.changedTouches[0]) || {};
  var x = t.clientX != null ? t.clientX : lastX;
  var y = t.clientY != null ? t.clientY : lastY;
  var dt = Math.max(1, now() - lastT);
  var dy = y - startY;
  var dx = x - startX;
  var vy = (y - lastY) / dt;
  var vx = (x - lastX) / dt;
  var should = false;
  if (mode === 'down') {
    should = dy > h * 0.25 || (vy > 0.55 && dy > 36);
  } else {
    should = dx > w * 0.25 || (vx > 0.55 && dx > 36);
  }
  if (should) {
    closing = true;
    var dest = mode === 'down'
      ? ('translate3d(0,' + h + 'px,0)')
      : ('translate3d(' + w + 'px,0,0)');
    ins.setStyle({
      'transform': dest,
      'transition': 'transform 0.28s cubic-bezier(0.32, 0.72, 0, 1)'
    });
    ins.callMethod('onSheetDismiss');
  } else {
    ins.setStyle({
      'transform': 'translate3d(0,0,0)',
      'transition': 'transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1)'
    });
    ins.callMethod('onSheetDragEnd');
  }
  moving = false;
  mode = '';
}

module.exports = {
  onReset: onReset,
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd
};
