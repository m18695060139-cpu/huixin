.editor-wrap { position: relative; }
.editor-ph {
  position: absolute; left: 0; top: 0; right: 0;
  color: #C7C7CC; font-family: var(--letter-font); font-size: 32.692rpx; line-height: 1.9;
  white-space: pre-wrap; pointer-events: none;
}
.day-title { font-size: 30.769rpx; font-weight: 600; display: block; text-align: center; }
.nav-btn.off { color: var(--ring); }
.round-btn.ghost { background: transparent; }
.sent .tick {
  width: 15.385rpx; height: 9.615rpx; border-left: 3.846rpx solid #000000; border-bottom: 3.846rpx solid #000000;
  transform: rotate(-45deg); margin-top: -3.846rpx;
}
.dot { width: 57.692rpx; height: 57.692rpx; }
