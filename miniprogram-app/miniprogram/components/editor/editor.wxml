<view class="editor-root theme-{{theme}}" wx:if="{{show}}" style="--safe-top: {{statusBar}}px; --safe-bottom: {{safeBottom}}px;">
  <view class="sheet enter">
    <view class="sheet-bar">
      <view>
        <button class="x" bindtap="onClose" aria-label="关闭"><view class="i i-x"></view></button>
        <text class="t">{{mode === 'drop' ? '放下这件事' : (mode === 'idea' ? (item.id ? '编辑点子' : '记一个点子') : (item.id ? '编辑待办' : '加一件事'))}}</text>
        <view class="sp"></view>
      </view>
    </view>
    <view class="page">
      <block wx:if="{{mode === 'drop'}}">
        <text class="drop-what">{{item.text}}</text>
        <view class="field">
          <text class="lab">为什么放下？</text>
          <textarea class="input area-3" auto-height="true" fixed="true" adjust-position="true" cursor-spacing="120" disable-default-padding="true" placeholder-class="ph" placeholder-style="font-size:32.692rpx;line-height:1.6;" value="{{note}}" bindinput="onNote" maxlength="500" placeholder="写一句就好，以后回头看会用得上。也可以不写。" />
        </view>
        <view class="chips wrap">
          <button class="chip" wx:for="{{reasons}}" wx:key="*this" data-v="{{item}}" bindtap="onReason">{{item}}</button>
        </view>
        <text class="note">放下的事会和原因一起留在「完成 / 放下」里，随时可以恢复。回信和周信也会看到。</text>
        <view style="display:flex;gap:19.231rpx;margin-top:42.308rpx;">
          <button class="btn" bindtap="onDrop">放下</button>
          <button class="btn ghost" bindtap="onClose">先不放下</button>
        </view>
      </block>

      <block wx:elif="{{mode === 'idea'}}">
        <view class="field">
          <text class="lab">点子</text>
          <textarea class="input area-3" auto-height="true" fixed="true" adjust-position="true" cursor-spacing="120" disable-default-padding="true" placeholder-class="ph" placeholder-style="font-size:32.692rpx;line-height:1.6;" value="{{text}}" bindinput="onText" maxlength="300" />
        </view>
        <text class="note" wx:if="{{item.source}}">{{item.source}}</text>
        <view style="display:flex;gap:19.231rpx;margin-top:50rpx;flex-wrap:wrap;">
          <button class="btn" bindtap="onSave">保存</button>
          <button wx:if="{{item.id}}" class="btn ghost" bindtap="onToTodo">转成待办</button>
          <button wx:if="{{item.id}}" class="btn ghost" bindtap="onIdeaDrop">放下</button>
        </view>
      </block>

      <block wx:else>
        <view class="field">
          <text class="lab">要做的事</text>
          <textarea class="input area-2" auto-height="true" fixed="true" adjust-position="true" cursor-spacing="120" disable-default-padding="true" placeholder-class="ph" placeholder-style="font-size:32.692rpx;line-height:1.6;" value="{{text}}" bindinput="onText" maxlength="200" />
        </view>
        <view class="field">
          <text class="lab">截止日期</text>
          <picker mode="date" value="{{due}}" bindchange="onDue">
            <view class="input">{{due || '不设日期，点这里选'}}</view>
          </picker>
          <button wx:if="{{due}}" class="lk muted" bindtap="clearDue">清掉日期</button>
        </view>
        <view class="field">
          <text class="lab">备注</text>
          <textarea class="input area-3" auto-height="true" fixed="true" adjust-position="true" cursor-spacing="120" disable-default-padding="true" placeholder-class="ph" placeholder-style="font-size:32.692rpx;line-height:1.6;" id="note" value="{{note}}" focus="{{focusNote}}" bindinput="onNote" maxlength="500" placeholder="进展、新想法，做完的感受，或者为什么做不了，都可以写。回信和周信会看到。" />
        </view>
        <text class="note" wx:if="{{droppedLabel}}">{{droppedLabel}}</text>
        <text class="note" wx:if="{{item.source}}">{{item.source}}</text>
        <view style="display:flex;gap:19.231rpx;margin-top:50rpx;flex-wrap:wrap;">
          <button class="btn" bindtap="onSave">保存</button>
          <button wx:if="{{item.id && item.dropped_at}}" class="btn ghost" bindtap="onUndrop">恢复成待办</button>
          <button wx:if="{{item.id && !item.dropped_at && !item.done}}" class="btn ghost" bindtap="onAskDrop">放下</button>
          <button wx:if="{{item.id}}" class="btn ghost" bindtap="onDelete">删除</button>
        </view>
      </block>
    </view>
  </view>
</view>
