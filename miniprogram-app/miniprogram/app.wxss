.chip-dot { width: 13.462rpx; height: 13.462rpx; border-radius: 7.692rpx; background: var(--ink); flex: none; }
.chip.on { background: var(--ink); color: var(--on-ink); font-weight: 600; }
.chip.on .chip-dot { background: var(--on-ink); }
.env-art { width: 384.615rpx; height: 246.154rpx; }
.env-card {
  width: 384.615rpx; height: 246.154rpx; border-radius: 26.923rpx; background: var(--card); position: relative; overflow: hidden;
}
.env-flap {
