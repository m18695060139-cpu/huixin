.xmark { width: 19.231rpx; height: 19.231rpx; position: relative; }
.xmark::before, .xmark::after {
  content: ""; position: absolute; left: 7.692rpx; top: 0; width: 2.885rpx; height: 19.231rpx; background: var(--sub);
}
.xmark::before { transform: rotate(45deg); }
.xmark::after { transform: rotate(-45deg); }
