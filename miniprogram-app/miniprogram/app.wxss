/* WXML 没有 h1/span/b，用同名 class 接上原来的元素选择器 */
.h1 { margin: 0; font-family: var(--title-font); font-size: 65.385rpx; font-weight: 700; letter-spacing: -0.962rpx; line-height: 1.2; display: block; }
.h2 { margin: 0; font-size: 38.462rpx; font-weight: 700; display: block; }
.h1.sm { font-size: 53.846rpx; }
