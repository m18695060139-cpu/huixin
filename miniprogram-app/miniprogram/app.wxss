.row-main.done .row-t { color: var(--sub); text-decoration: line-through; }
.row.day .row-t { font-size: 28.846rpx; }
.row.gapday .row-t { color: var(--sub); }
.row.hist .row-t { color: var(--sub); font-size: 30.769rpx; }
.gh-s { font-size: 25rpx; color: var(--sub); }
.b { font-weight: 700; }
.tile .b { font-size: 50rpx; line-height: 1.1; display: block; }
.stat .b { font-size: 38.462rpx; display: block; }
.stat .unit { font-size: 25rpx; color: var(--sub); font-weight: 500; }
.big-num .b { font-size: 53.846rpx; }
.dt .num { font-size: 30.769rpx; font-weight: 700; line-height: 1.05; }
.dt .wd { font-size: 17.308rpx; font-weight: 600; line-height: 1.05; }
.letter-text { display: block; }
.q { display: block; }
.hero-t, .hero-s, .env-t, .env-s { display: block; }
