}
.send-inner { max-width: 1015.385rpx; margin: 0 auto; display: flex; flex-direction: column; gap: 15.385rpx; }
.paper-label { font-size: 28.846rpx; font-weight: 600; color: var(--sub); }
.habit-lab { font-size: 25rpx; font-weight: 600; color: var(--sub); padding-right: 3.846rpx; }
.daynav .lab .sub { font-size: 21.154rpx; }

/* 微信 button 自带宽度和居中，会把卡片、顶栏、分段撑乱。这里按网页版把尺寸钉死。 */
button {
  margin: 0;
  padding: 0;
  width: auto;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  text-align: inherit;
  background-color: transparent;
  border-radius: 0;
}
button::after { display: none; border: none; }
button.card, button.envelope, button.tile, button.row, button.digest {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  text-align: left;
  align-items: stretch;
}
button.envelope {
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  text-align: center;
}
button.envelope .env-t, button.envelope .env-s, button.envelope .env-btn { width: 100%; text-align: center; }
button.row-main {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  align-items: stretch;
  justify-content: center;
  text-align: left;
}
button.row-main .row-t, button.row-main .sub { width: 100%; text-align: left; }
button.ck {
  flex: none;
  width: 84.615rpx;
  min-width: 84.615rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
}
button.lk {
  width: auto;
  flex: none;
  margin: 0;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
}
button.theme-opt {
  width: calc((100% - 38.462rpx) / 3);
  flex: 0 0 calc((100% - 38.462rpx) / 3);
  min-width: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  overflow: hidden;
}
button.card { background-color: var(--card); }
button.envelope { background-color: var(--ink); color: var(--on-ink); margin-top: 30.769rpx; }
button.tile { background-color: var(--card); align-items: flex-start; flex-direction: column; }
button.btn {
  background-color: var(--ink);
  color: var(--on-ink);
  height: 96.154rpx;
  border-radius: 48.077rpx;
  padding: 0 46.154rpx;
  font-size: 30.769rpx;
  font-weight: 600;
}
button.btn.full, .send-row button.btn { width: 100%; flex: 1; height: 100rpx; border-radius: 50rpx; font-size: 32.692rpx; }
button.btn.ghost { background-color: var(--tile); color: var(--text); }
button.btn.sm { height: 69.231rpx; border-radius: 34.615rpx; padding: 0 30.769rpx; font-size: 26.923rpx; width: auto; flex: none; }
button.btn.dark { background-color: #2C2C2E; color: #FFFFFF; }
button.btn.light { background-color: #FFFFFF; color: #000000; }
button.lk { width: auto; background: transparent; color: var(--ink); padding: 19.231rpx 0; }
button.chip, .chip {
  width: auto;
  flex: none;
  height: 69.231rpx;
  padding: 0 26.923rpx;
  border-radius: 34.615rpx;
  background-color: var(--card);
  font-size: 26.923rpx;
  display: flex;
  align-items: center;
  gap: 11.538rpx;
  white-space: nowrap;
}
.chip.on, button.chip.on { background-color: var(--ink); color: var(--on-ink); font-weight: 600; }
.hb, button.hb {
  flex: 1 1 123.077rpx;
  min-width: 123.077rpx;
  height: 76.923rpx;
  border-radius: 38.462rpx;
  border: 2.885rpx solid var(--sep);
  background-color: var(--card);
  font-size: 26.923rpx;
  padding: 0 19.231rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7.692rpx;
}
.hb.on, button.hb.on { background-color: var(--ink); border-color: var(--ink); color: var(--on-ink); font-weight: 600; }
.round-btn, button.round-btn {
  width: 76.923rpx;
  min-width: 76.923rpx;
  max-width: 76.923rpx;
  height: 76.923rpx;
  padding: 0;
  border-radius: 38.462rpx;
  background-color: var(--card);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn, button.nav-btn {
  width: 76.923rpx;
  min-width: 76.923rpx;
  max-width: 76.923rpx;
  height: 84.615rpx;
  padding: 0;
  flex: none;
  color: var(--ink);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42.308rpx;
}
.wbar { flex-wrap: nowrap; }
.wbar .daynav { flex: 1; min-width: 0; justify-content: center; }
.daynav .lab { min-width: 0; }
.seg button, .mini-seg button, .seg .seg-btn {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  margin: 0;
  height: 61.538rpx;
  border-radius: 15.385rpx;
  background-color: transparent;
  font-size: 25rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.sheet-bar .x, button.x {
  width: 65.385rpx;
  min-width: 65.385rpx;
  max-width: 65.385rpx;
  height: 65.385rpx;
  border-radius: 32.692rpx;
  background-color: var(--card);
  padding: 0;
}
.head { align-items: flex-end; }
.head.stick-top, .wbar.stick-top {
  padding-bottom: 15.385rpx;
  background: var(--bg);
}
.memo, button.memo { width: 100%; align-items: flex-start; }
