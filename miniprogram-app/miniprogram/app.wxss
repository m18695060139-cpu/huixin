.chip-dot { width: 7px; height: 7px; border-radius: 4px; background: var(--ink); flex: none; }
.chip.on { background: var(--ink); color: var(--on-ink); font-weight: 600; }
.chip.on .chip-dot { background: var(--on-ink); }
.env-art { width: 200px; height: 128px; }
.env-card {
  width: 200px; height: 128px; border-radius: 14px; background: var(--card); position: relative; overflow: hidden;
}
.env-flap {
  position: absolute; left: 0; top: 0; width: 0; height: 0;
  border-left: 100px solid transparent; border-right: 100px solid transparent; border-top: 74px solid var(--tint);
}
.env-seal {
  position: absolute; left: 84px; top: 56px; width: 32px; height: 32px; border-radius: 16px;
  background: var(--ink); color: var(--on-ink); font-size: 15px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.env-big {
  width: 300px; height: 190px; border-radius: 16px; background: #FFFFFF; position: relative; overflow: hidden; margin: 0 auto;
}
.env-big-flap {
  position: absolute; left: 0; top: 0; width: 0; height: 0;
  border-left: 150px solid transparent; border-right: 150px solid transparent; border-top: 110px solid #FFE3DE;
}
.env-big-line {
  position: absolute; left: 16px; right: 16px; top: 0; height: 110px;
  border-bottom: 2px solid #E5E5EA; transform: rotate(0deg);
}
.env-stamp {
  position: absolute; right: 18px; top: 18px; width: 46px; height: 54px; border-radius: 6px; background: #FFE3DE;
  color: #D0402B; font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center;
}
.pm-stamp {
  position: absolute; left: 168px; top: 36px; width: 56px; height: 56px; border-radius: 28px;
  border: 2px solid #D0402B; color: #D0402B; display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 10px; line-height: 1.25; background: transparent;
}
.pm-stamp text:last-child { font-size: 12px; font-weight: 700; }
.env-big-to { position: absolute; left: 24px; bottom: 16px; color: #6C6C70; font-size: 14px; }
.sent .h1 { margin-top: 36px; font-size: 28px; text-align: center; font-weight: 700; display: block; }
.mood-box { margin-top: 12px; padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 8px; }
.mood-box .lab { font-size: 13px; font-weight: 600; color: var(--sub); }
.energy { display: flex; gap: 8px; }
.energy .hb { flex: 1; }
.chart-box { width: 100%; height: 88px; }
.chart { width: 100%; height: 88px; display: block; }
.warn {
  margin: 12px 4px 0; background: var(--tint); color: var(--ink-text);
  border-radius: 12px; padding: 10px 12px; font-size: 13px; line-height: 1.55;
}
.sent-steps-clock {
  width: 16px; height: 16px; border-radius: 8px; border: 1.5px solid #98989D; position: relative; box-sizing: border-box;
}
.sent-steps-clock::before {
  content: ""; position: absolute; left: 6px; top: 3px; width: 1.5px; height: 5px; background: #98989D;
}
.ph { color: #C7C7CC; }
.theme-night .ph { color: #636366; }
.sheet .page { padding-top: 8px; }
.subpage-bar { position: sticky; top: 0; z-index: 2; background: var(--bg); }
.bullet { padding: 2px 0; }
.privacy-body { font-size: 15px; line-height: 1.7; color: var(--text); }
.privacy-body .h { font-size: 16px; font-weight: 700; margin: 18px 0 6px; }
.tabbar .tab { position: relative; }
.editor-root { position: relative; z-index: 30; }

/* WXML 没有 h1/span/b，用同名 class 接上原来的元素选择器 */
.h1 { margin: 0; font-family: var(--title-font); font-size: 34px; font-weight: 700; letter-spacing: -.5px; line-height: 1.2; display: block; }
.h2 { margin: 0; font-size: 20px; font-weight: 700; display: block; }
.h1.sm { font-size: 28px; }
.row-t { font-size: 16px; line-height: 1.35; display: block; }
.row-main.done .row-t { color: var(--sub); text-decoration: line-through; }
.row.day .row-t { font-size: 15px; }
.row.gapday .row-t { color: var(--sub); }
.row.hist .row-t { color: var(--sub); font-size: 16px; }
.gh-s { font-size: 13px; color: var(--sub); }
.b { font-weight: 700; }
.tile .b { font-size: 26px; line-height: 1.1; display: block; }
.stat .b { font-size: 20px; display: block; }
.stat .unit { font-size: 13px; color: var(--sub); font-weight: 500; }
.big-num .b { font-size: 28px; }
.dt .num { font-size: 16px; font-weight: 700; line-height: 1.05; }
.dt .wd { font-size: 9px; font-weight: 600; line-height: 1.05; }
.letter-text { display: block; }
.q { display: block; }
.hero-t, .hero-s, .env-t, .env-s { display: block; }
.sheet-bar > view {
  max-width: 560px; margin: 0 auto; height: 52px; display: flex;
  align-items: center; justify-content: space-between; gap: 8px; padding: 0 16px;
}
.send-inner { max-width: 528px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
.paper-label { font-size: 15px; font-weight: 600; color: var(--sub); }
.habit-lab { font-size: 13px; font-weight: 600; color: var(--sub); padding-right: 2px; }
.daynav .lab .sub { font-size: 11px; }
