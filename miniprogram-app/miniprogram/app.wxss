/* 回信 · 小程序样式
   从网页版 public/app.css 迁来。长度按 390 宽换算：1px = 750/390 rpx。
   --safe-top / --safe-bottom 仍是设备像素，由页面行内样式覆盖。
   电脑宽屏侧栏是网页版专用，小程序不搬。 */
/* 回信 · 样式
   原生卡片：灰底 + 白卡片 + 一个主色。四套外观只换一组变量；结构、间距、交互完全一样 */

.theme-ink, .theme-night, .theme-paper, .theme-mono {
  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;
  --title-font: var(--sans);
  --letter-font: var(--serif);
  --safe-top: 20px;
  --safe-bottom: 0px;
}
.theme-ink {
  --bg: #F2F2F7; --card: #FFFFFF; --text: #000000; --sub: #6C6C70; --sep: #E5E5EA;
  --tile: #F2F2F7; --ring: #C7C7CC; --tab: #6C6C70;
  --ink: #D0402B; --on-ink: #FFFFFF; --tint: #FFE3DE; --ink-text: #C0352B;
  --amber: #9A5B00; --amber-tint: #FFF1D6; --green: #248A3D; --green-tint: #E3F5E7; --idea: #FFCC00;
  --glass: rgba(255,255,255,0.9); --shadow: 0 15.385rpx 57.692rpx rgba(0,0,0,.12); --danger: #C0352B;
  --title-font: var(--sans); --letter-font: var(--serif);
  --r: 42.308rpx; --r-sm: 26.923rpx; --check: 50%;
  color-scheme: light;
}
.theme-night {
  --bg: #000000; --card: #1C1C1E; --text: #FFFFFF; --sub: #98989D; --sep: #38383A;
  --tile: #2C2C2E; --ring: #636366; --tab: #98989D;
  --ink: #FF6B5E; --on-ink: #000000; --tint: rgba(255,107,94,.18); --ink-text: #FF8A80;
  --amber: #FFB340; --amber-tint: rgba(255,179,64,.16); --green: #30D158; --green-tint: rgba(48,209,88,.16); --idea: #FFD60A;
  --glass: rgba(28,28,30,0.9); --shadow: 0 15.385rpx 57.692rpx rgba(0,0,0,.6); --danger: #FF6B5E;
  color-scheme: dark;
}
.theme-paper {
  --bg: #F4EEE4; --card: #FFFDF8; --text: #2A241F; --sub: #6F655C; --sep: #EDE4D6;
  --tile: #F4EEE4; --ring: #CDBFAA; --tab: #8C8277;
  --ink: #B4432F; --on-ink: #FFFFFF; --tint: #F6E2DA; --ink-text: #A13A28;
  --amber: #8A5A00; --amber-tint: #F8EBD2; --green: #3F7A3A; --green-tint: #E6F0DF; --idea: #E9B949;
  --glass: rgba(255,253,248,0.92); --shadow: 0 19.231rpx 53.846rpx -15.385rpx rgba(80,55,30,.25); --danger: #A13A28;
  --title-font: var(--serif);
  color-scheme: light;
}
.theme-mono {
  --bg: #F2F2F2; --card: #FFFFFF; --text: #000000; --sub: #666666; --sep: #E3E3E3;
  --tile: #F2F2F2; --ring: #9A9A9A; --tab: #777777;
  --ink: #000000; --on-ink: #FFFFFF; --tint: #E8E8E8; --ink-text: #000000;
  --amber: #000000; --amber-tint: #EDEDED; --green: #000000; --green-tint: #EDEDED; --idea: #000000;
  --glass: rgba(255,255,255,0.94); --shadow: 0 11.538rpx 38.462rpx rgba(0,0,0,.14); --danger: #000000;
  --letter-font: var(--sans);
  --r: 11.538rpx; --r-sm: 7.692rpx; --check: 7.692rpx;
  color-scheme: light;
}

page, view, text, image, input, textarea, button, scroll-view, swiper, navigator, label { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
page {
  margin: 0; background: #F2F2F7; color: #000000;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 32.692rpx; line-height: 1.45;
}
button, input, textarea, select { font: inherit; color: inherit; }
button { cursor: pointer; }
a { color: var(--ink); }
:focus-visible { outline: 3.846rpx solid var(--ink); outline-offset: 3.846rpx; }
/* 按下去有反馈，像 App 一样 */
button, .tap { transition: transform .12s ease, opacity .12s ease; }
button:active:not(:disabled), .tap:active { transform: scale(.97); opacity: .85; }

.page {
  max-width: 1076.923rpx; margin: 0 auto;
  padding: 0 30.769rpx calc(env(safe-area-inset-bottom) + 40px);
  min-height: 100vh;
}
/* 三个 tab 页：底栏约 64px 胶囊 + 上下外边距，再留一截空，最后一张卡要完整露在底栏上面 */
.page.tab-pad { padding-bottom: calc(env(safe-area-inset-bottom) + 136px); }
.page.bare { padding-bottom: calc(env(safe-area-inset-bottom) + 220px); }
.stick-top {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 40;
  background: var(--bg);
  padding-bottom: 15.385rpx;
}
.top-shield {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 39;
  background: var(--bg);
}

/* ── 标题区 ── */
.head { display: flex; justify-content: space-between; align-items: flex-end; gap: 23.077rpx; padding: 0 7.692rpx; }
.head-l { display: flex; flex-direction: column; gap: 3.846rpx; min-width: 0; }
.eyebrow { font-size: 25rpx; font-weight: 600; color: var(--ink); }
h1 { margin: 0; font-family: var(--title-font); font-size: 65.385rpx; font-weight: 700; letter-spacing: -0.962rpx; line-height: 1.2; }
h2 { margin: 0; font-size: 38.462rpx; font-weight: 700; }
.count { min-width: 76.923rpx; height: 76.923rpx; padding: 0 15.385rpx; border-radius: 38.462rpx; background: var(--tint); color: var(--ink); display: flex; align-items: center; justify-content: center; font-size: 28.846rpx; font-weight: 700; flex: none; font-variant-numeric: tabular-nums; }
.round-btn { width: 76.923rpx; height: 76.923rpx; border-radius: 38.462rpx; border: none; background: var(--card); color: var(--text); display: grid; place-items: center; padding: 0; flex: none; }
.muted { color: var(--sub); }
.small { font-size: 25rpx; }

/* ── 卡片与分组 ── */
.card { background: var(--card); border-radius: var(--r); overflow: hidden; }
.card.pad { padding: 30.769rpx; }
.gh { display: flex; justify-content: space-between; align-items: baseline; gap: 23.077rpx; padding: 42.308rpx 7.692rpx 15.385rpx; }
.gh span { font-size: 25rpx; color: var(--sub); }
.gh-links { display: flex; gap: 3.846rpx; }
.gh-links .lk { font-size: 25rpx; padding: 11.538rpx 11.538rpx; margin: -11.538rpx 0; }
.mt { margin-top: 26.923rpx; }
.row { display: flex; align-items: center; gap: 23.077rpx; padding: 0 30.769rpx; min-height: 107.692rpx; width: 100%; border: none; background: none; text-align: left; color: var(--text); text-decoration: none; }
.row + .row, .row + details, details + .row { border-top: 0.962rpx solid var(--sep); }
.row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1.923rpx; padding: 17.308rpx 0; border: none; background: none; text-align: left; color: inherit; }
.row-main > span:first-child { font-size: 30.769rpx; line-height: 1.35; }
.row-main.done > span:first-child { color: var(--sub); text-decoration: line-through; }
.sub { font-size: 23.077rpx; color: var(--sub); }
.sub.hot { color: var(--ink); font-weight: 600; }
.sub.warm { color: var(--amber); font-weight: 600; }
.todo-note { color: var(--text); opacity: .75; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal; }
.ck.dropped { opacity: .55; }
.ck.dropped svg { opacity: 1; width: 26.923rpx; height: 26.923rpx; }
.done-line { width: 100%; border: none; background: none; color: inherit; text-align: left; font: inherit; cursor: pointer; }
.done-line .row-main span { color: var(--sub); }
.one-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chev { flex: none; color: var(--ring); }
.ck { width: 84.615rpx; height: 84.615rpx; margin: 0 -17.308rpx; border: none; background: none; padding: 0; display: grid; place-items: center; flex: none; }
.ck i { width: 50rpx; height: 50rpx; border-radius: var(--check); border: 3.846rpx solid var(--ring); display: grid; place-items: center; transition: background .15s, border-color .15s; }
.ck svg { opacity: 0; }
.ck.on i { background: var(--ink); border-color: var(--ink); }
.ck.on svg { opacity: 1; }
.pill { font-size: 23.077rpx; font-weight: 600; padding: 7.692rpx 17.308rpx; border-radius: 19.231rpx; flex: none; white-space: nowrap; background: var(--tile); color: var(--sub); }
.pill.red { background: var(--tint); color: var(--ink-text); }
.pill.amber { background: var(--amber-tint); color: var(--amber); }
.pill.green { background: var(--green-tint); color: var(--green); }
.ic { width: 57.692rpx; height: 57.692rpx; border-radius: 15.385rpx; display: grid; place-items: center; color: #FFFFFF; flex: none; background: var(--ink); }
.ic.sm { width: 50rpx; height: 50rpx; border-radius: 25rpx; }
.ic.idea { background: var(--idea); color: #1C1C1E; }
.ic.gray { background: #8E8E93; }
.lk { border: none; background: none; color: var(--ink); font-size: 28.846rpx; padding: 19.231rpx 0; white-space: nowrap; flex: none; }
.lk.muted { color: var(--sub); }
.row.foot { justify-content: space-between; }
.empty { padding: 34.615rpx 30.769rpx; font-size: 28.846rpx; color: var(--sub); line-height: 1.6; }

/* ── 按钮 ── */
.btn {
  height: 96.154rpx; border: none; border-radius: 48.077rpx; padding: 0 46.154rpx;
  background: var(--ink); color: var(--on-ink); font-size: 30.769rpx; font-weight: 600; white-space: nowrap; flex: none;
  display: inline-flex; align-items: center; justify-content: center; gap: 15.385rpx; text-decoration: none;
}
.btn:disabled { opacity: .35; }
.btn.ghost { background: var(--tile); color: var(--text); }
.btn.full { width: 100%; }
.btn.sm { height: 69.231rpx; border-radius: 34.615rpx; padding: 0 30.769rpx; font-size: 26.923rpx; }

/* ── 首页主角卡片 ── */
.hero { margin-top: 30.769rpx; padding: 34.615rpx; display: flex; flex-direction: column; gap: 26.923rpx; }
.hero-top { display: flex; align-items: center; gap: 26.923rpx; }
.hero-ic { width: 92.308rpx; height: 92.308rpx; border-radius: 26.923rpx; background: var(--ink); color: var(--on-ink); display: grid; place-items: center; flex: none; }
.hero-t { font-size: 32.692rpx; font-weight: 700; }
.hero-s { font-size: 25rpx; color: var(--sub); }
.envelope {
  margin-top: 30.769rpx; width: 100%; border: none; border-radius: var(--r); background: var(--ink); color: var(--on-ink);
  padding: 50rpx 38.462rpx 38.462rpx; display: flex; flex-direction: column; align-items: center; gap: 34.615rpx; text-align: center;
}
.envelope .env-t { font-size: 42.308rpx; font-weight: 700; }
.envelope .env-s { font-size: 26.923rpx; opacity: .9; margin-top: 7.692rpx; }
.envelope .env-btn { width: 100%; height: 92.308rpx; border-radius: 46.154rpx; background: var(--card); color: var(--ink); display: grid; place-items: center; font-size: 30.769rpx; font-weight: 700; }
.bob { animation: bob 3.2s ease-in-out infinite; }
@keyframes bob { 0%,100% { transform: translateY(0) rotate(-2deg) } 50% { transform: translateY(-11.538rpx) rotate(-2deg) } }
.memo { margin-top: 26.923rpx; padding: 30.769rpx; display: flex; flex-direction: column; gap: 15.385rpx; width: 100%; border: none; text-align: left; }
.memo .lab { font-size: 25rpx; font-weight: 600; color: var(--sub); }
.memo .q { font-family: var(--letter-font); font-size: 32.692rpx; line-height: 1.7; }

/* ── 写信 ── */
.wbar { display: flex; align-items: center; justify-content: space-between; gap: 15.385rpx; padding: 0 7.692rpx; min-height: 92.308rpx; }
.daynav { display: flex; align-items: center; }
.daynav .lab { min-width: 215.385rpx; display: flex; flex-direction: column; align-items: center; }
.daynav .lab b { font-size: 30.769rpx; font-weight: 600; }
.daynav .lab span { font-size: 21.154rpx; color: var(--sub); }
.nav-btn { width: 76.923rpx; height: 84.615rpx; border: none; background: none; color: var(--ink); display: grid; place-items: center; padding: 0; }
.nav-btn:disabled { color: var(--ring); }
.save-state { width: 76.923rpx; font-size: 23.077rpx; color: var(--sub); text-align: right; }
.paper { margin-top: 15.385rpx; padding: 34.615rpx 38.462rpx 38.462rpx; display: flex; flex-direction: column; gap: 19.231rpx; }
.paper-h { display: flex; justify-content: space-between; align-items: center; }
.paper-h span { font-size: 28.846rpx; font-weight: 600; color: var(--sub); }
.no-tag { font-size: 23.077rpx; font-weight: 700; color: var(--ink); background: var(--tint); border-radius: 19.231rpx; padding: 5.769rpx 17.308rpx; }
.editor {
  width: 100%; min-height: 40vh; border: none; outline: none; resize: none; background: transparent; padding: 0;
  font-family: var(--letter-font); font-size: 32.692rpx; line-height: 1.9;
}
.editor::placeholder { color: var(--ring); }
.letter-text { margin: 0; font-family: var(--letter-font); font-size: 32.692rpx; line-height: 1.9; white-space: pre-wrap; word-break: break-word; }
.chips { margin-top: 23.077rpx; display: flex; gap: 15.385rpx; overflow-x: auto; scrollbar-width: none; padding-bottom: 3.846rpx; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: none; height: 69.231rpx; padding: 0 26.923rpx; border-radius: 34.615rpx; border: none; background: var(--card); font-size: 26.923rpx; display: flex; align-items: center; gap: 11.538rpx; }
.chip i { width: 13.462rpx; height: 13.462rpx; border-radius: 7.692rpx; background: var(--ink); }
.habits { margin-top: 23.077rpx; padding: 19.231rpx 23.077rpx; display: flex; align-items: center; gap: 15.385rpx; flex-wrap: wrap; }
.habits > span { font-size: 25rpx; font-weight: 600; color: var(--sub); padding-right: 3.846rpx; }
.hb { flex: 1 1 123.077rpx; min-width: 123.077rpx; height: 76.923rpx; border-radius: 38.462rpx; border: 2.885rpx solid var(--sep); background: var(--card); font-size: 26.923rpx; display: flex; align-items: center; justify-content: center; gap: 7.692rpx; padding: 0 19.231rpx; }
.hb.on { background: var(--ink); border-color: var(--ink); color: var(--on-ink); font-weight: 600; }
.hb svg { display: none; }
.hb.on svg { display: block; }
.send-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 5;
  padding: 19.231rpx 30.769rpx calc(var(--safe-bottom) + 26.923rpx); background: linear-gradient(to bottom, transparent, var(--bg) 30%);
}
.send-bar > div { max-width: 1015.385rpx; margin: 0 auto; display: flex; flex-direction: column; gap: 15.385rpx; }
.send-row { display: flex; align-items: center; gap: 23.077rpx; }
.send-row .btn { flex: 1; height: 100rpx; border-radius: 50rpx; font-size: 32.692rpx; }
.mic { width: 100rpx; height: 100rpx; border-radius: 50rpx; border: none; background: var(--card); color: var(--ink); display: grid; place-items: center; flex: none; padding: 0; }
.mic.on { background: var(--ink); color: var(--on-ink); animation: pulse-bg 1.2s ease-in-out infinite; }
@keyframes pulse-bg { 50% { opacity: .7 } }
.send-note { font-size: 23.077rpx; color: var(--sub); text-align: center; }
.sealed { margin-top: 26.923rpx; }

/* ── 寄出（夜色，固定深色） ── */
.sent {
  position: fixed; inset: 0; z-index: 30; background: #000000; color: #FFFFFF; overflow-y: auto;
  padding: calc(var(--safe-top) + 138.462rpx) 30.769rpx calc(var(--safe-bottom) + 46.154rpx);
  display: flex; flex-direction: column; align-items: center;
}
.sent > view, .sent > text, .sent > button, .sent > image { width: 100%; max-width: 807.692rpx; }
.sent .env-wrap { display: flex; justify-content: center; animation: drift .8s cubic-bezier(.2,.8,.2,1) both; }
.sent .pm { transform-origin: 453.846rpx 123.077rpx; animation: stamp .8s .5s ease-out both; }
.sent h1 { margin-top: 69.231rpx; font-size: 53.846rpx; text-align: center; }
.sent .lead { margin: 15.385rpx 0 0; font-size: 28.846rpx; color: #98989D; text-align: center; }
.steps { margin-top: 53.846rpx; background: #1C1C1E; border-radius: 42.308rpx; overflow: hidden; }
.steps .row { color: #FFFFFF; min-height: 111.538rpx; }
.steps .row + .row { border-top-color: #38383A; }
.steps .dot { width: 57.692rpx; height: 57.692rpx; border-radius: 28.846rpx; display: grid; place-items: center; flex: none; background: #2C2C2E; color: #98989D; }
.steps .dot.ok { background: #30D158; color: #000000; }
.steps .dot.err { background: #FF6B5E; color: #000000; }
.steps .t { flex: 1; font-size: 30.769rpx; }
.steps .t.dim { color: #98989D; }
.steps .tm { font-size: 25rpx; color: #98989D; }
.spin { animation: spin 1.2s linear infinite; }
.sent-btns { margin-top: auto; padding-top: 53.846rpx; display: flex; gap: 19.231rpx; }
.sent-btns .btn { flex: 1; height: 100rpx; border-radius: 50rpx; }
.sent-btns .btn.dark { background: #2C2C2E; color: #FFFFFF; }
.sent-btns .btn.light { background: #FFFFFF; color: #000000; }
@keyframes drift { from { transform: translateY(57.692rpx) scale(.9); opacity: 0 } to { transform: none; opacity: 1 } }
@keyframes stamp { 0%,40% { transform: scale(1.7); opacity: 0 } 70% { transform: scale(.94); opacity: 1 } 100% { transform: scale(1); opacity: 1 } }
@keyframes spin { to { transform: rotate(360deg) } }

/* ── 回信 ── */
.reply-letter { margin-top: 23.077rpx; padding: 42.308rpx 38.462rpx; display: flex; flex-direction: column; gap: 26.923rpx; animation: rise .5s cubic-bezier(.2,.8,.2,1) both; }
.reply-letter p { margin: 0; font-family: var(--letter-font); font-size: 30.769rpx; line-height: 1.95; white-space: pre-line; }
.reply-sign { display: flex; align-items: center; justify-content: flex-end; gap: 15.385rpx; padding-top: 15.385rpx; border-top: 0.962rpx solid var(--sep); }
.reply-sign b { font-size: 26.923rpx; color: var(--ink); }
.reply-sign span { font-size: 23.077rpx; color: var(--sub); }
details.mine summary { list-style: none; cursor: pointer; }
details.mine summary::-webkit-details-marker { display: none; }
details.mine[open] summary .chev { transform: rotate(90deg); }
details.mine .letter-text { padding: 0 30.769rpx 30.769rpx; font-size: 28.846rpx; line-height: 1.85; color: var(--sub); }
.pop { animation: pop .4s both; }
.stats { padding: 26.923rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15.385rpx; }
.stat { background: var(--tile); border-radius: var(--r-sm); padding: 23.077rpx; display: flex; flex-direction: column; gap: 3.846rpx; min-width: 0; }
.stat span { font-size: 23.077rpx; color: var(--sub); }
.stat b { font-size: 38.462rpx; font-weight: 700; }
.stat b small { font-size: 25rpx; color: var(--sub); font-weight: 500; }
.lens { align-items: flex-start; padding-top: 26.923rpx; padding-bottom: 26.923rpx; }
.lens .ic { width: 50rpx; height: 50rpx; border-radius: 13.462rpx; font-size: 23.077rpx; font-weight: 700; }
.lens .row-main { padding: 0; gap: 3.846rpx; }
.lens .row-main > span:first-child, .lens-k { font-size: 25rpx; font-weight: 600; color: var(--sub); display: block; }
.lens .row-main > span:last-child, .lens-v { font-size: 28.846rpx; line-height: 1.5; display: block; }
.seg2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); background: var(--tile); border-radius: 19.231rpx; padding: 3.846rpx; width: 269.231rpx; flex: none; }
.seg2 button { height: 61.538rpx; border: none; border-radius: 15.385rpx; background: transparent; font-size: 25rpx; }
.seg2 button.on, .seg2 .seg2-btn.on { background: var(--card); box-shadow: 0 1.923rpx 5.769rpx rgba(0,0,0,.12); font-weight: 600; }
.seg2 .seg2-btn { height: 61.538rpx; border-radius: 15.385rpx; background: transparent; font-size: 25rpx; display: flex; align-items: center; justify-content: center; color: var(--text); }
.waiting { display: flex; align-items: center; gap: 19.231rpx; padding: 34.615rpx 30.769rpx; color: var(--sub); font-size: 28.846rpx; }
.note { margin: 19.231rpx 7.692rpx 0; font-size: 25rpx; line-height: 1.55; color: var(--sub); }
@keyframes rise { from { transform: translateY(57.692rpx); opacity: 0 } to { transform: none; opacity: 1 } }
@keyframes pop { 0% { transform: scale(.4); opacity: 0 } 70% { transform: scale(1.08); opacity: 1 } 100% { transform: scale(1); opacity: 1 } }
@keyframes drop { from { transform: translateY(-23.077rpx); opacity: 0 } to { transform: none; opacity: 1 } }
.fresh { animation: drop .6s both; }

/* ── 信箱 ── */
.seg { margin-top: 30.769rpx; background: var(--tile); border-radius: 19.231rpx; padding: 3.846rpx; display: flex; width: 100%; box-sizing: border-box; }
.theme-ink .seg, .theme-mono .seg { background: #E3E3E8; }
.seg.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.seg button { height: 61.538rpx; border: none; border-radius: 15.385rpx; background: transparent; font-size: 25rpx; }
.seg button[aria-selected="true"] { background: var(--card); box-shadow: 0 1.923rpx 5.769rpx rgba(0,0,0,.12); font-weight: 600; }
.tiles { margin-top: 26.923rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 19.231rpx; }
.tile { background: var(--card); border-radius: 34.615rpx; padding: 26.923rpx; border: none; text-align: left; display: flex; flex-direction: column; gap: 7.692rpx; }
.tile span { font-size: 23.077rpx; font-weight: 600; color: var(--sub); }
.tile b { font-size: 50rpx; font-weight: 700; line-height: 1.1; }
.big-num { display: flex; align-items: baseline; gap: 15.385rpx; flex-wrap: wrap; }
.big-num b { font-size: 53.846rpx; font-weight: 700; }
.big-num .up { margin-left: auto; font-size: 25rpx; font-weight: 600; color: var(--green); }
.big-num .down { margin-left: auto; font-size: 25rpx; font-weight: 600; color: var(--amber); }
.chart { margin-top: 19.231rpx; width: 100%; height: auto; display: block; overflow: visible; }
.chart-x { margin-top: 11.538rpx; display: flex; justify-content: space-between; font-size: 21.154rpx; color: var(--sub); }
.kv { display: flex; justify-content: space-between; gap: 23.077rpx; font-size: 25rpx; margin-top: 19.231rpx; }
.kv:first-of-type { margin-top: 26.923rpx; padding-top: 23.077rpx; border-top: 0.962rpx solid var(--sep); }
.kv span { color: var(--sub); flex: none; }
.kv b { font-weight: 600; text-align: right; }
.digest {
  width: 100%; border: none; text-align: left; display: flex; flex-direction: column; gap: 15.385rpx;
  background: var(--ink); color: var(--on-ink); border-radius: var(--r); padding: 34.615rpx;
}
.digest text { color: var(--on-ink); }
.digest-h { display: flex; justify-content: space-between; align-items: center; gap: 15.385rpx; font-size: 23.077rpx; font-weight: 600; }
.digest-h .badge { background: rgba(255,255,255,.22); border-radius: 19.231rpx; padding: 5.769rpx 17.308rpx; }
.digest-t { font-size: 36.538rpx; font-weight: 700; line-height: 1.45; }
.digest-b { font-size: 28.846rpx; line-height: 1.6; opacity: .92; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.digest-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15.385rpx; margin-top: 7.692rpx; }
.digest-stats > span, .digest-stats > view { background: rgba(255,255,255,.16); border-radius: 23.077rpx; padding: 15.385rpx 19.231rpx; display: flex; flex-direction: column; }
.digest-stats > span > span, .digest-stats > view > text { font-size: 21.154rpx; opacity: .9; }
.digest-stats b, .digest-stats .b { font-size: 34.615rpx; font-weight: 700; }
.digest-more { font-size: 26.923rpx; font-weight: 600; }
.dt { width: 80.769rpx; height: 80.769rpx; flex: none; border-radius: 40.385rpx; background: var(--tint); color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.05; }
.dt b { font-size: 30.769rpx; }
.dt span { font-size: 17.308rpx; font-weight: 600; }
.dt.gap { background: transparent; color: var(--sub); border: 2.885rpx dashed var(--ring); }
.dt.sq { border-radius: 19.231rpx; font-size: 23.077rpx; font-weight: 700; }
.dt.sq.dark { background: var(--text); color: var(--bg); }
.row.day { min-height: 119.231rpx; }
.row.day .row-main > span:first-child { font-size: 28.846rpx; }
.row.gapday .row-main > span:first-child { color: var(--sub); }

/* ── 底部导航：悬浮胶囊 ── */
.tabbar {
  position: fixed; left: 30.769rpx; right: 30.769rpx; bottom: calc(var(--safe-bottom) + 26.923rpx); z-index: 10;
  max-width: 1015.385rpx; margin: 0 auto; height: 123.077rpx; border-radius: 61.538rpx; padding: 0 15.385rpx;
  background: var(--glass); -webkit-backdrop-filter: saturate(180%) blur(38.462rpx); backdrop-filter: saturate(180%) blur(38.462rpx);
  box-shadow: var(--shadow); display: flex; align-items: center;
}
.tabbar nav { flex: 1; display: flex; align-items: center; height: 100%; }
.tabbar nav button { flex: 1; height: 103.846rpx; border: none; background: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3.846rpx; color: var(--tab); font-size: 19.231rpx; font-weight: 500; position: relative; }
.tabbar nav button[aria-current="page"] { color: var(--ink); font-weight: 600; }
.tabbar nav button.write { flex: none; width: 100rpx; height: 100rpx; border-radius: 50rpx; background: var(--ink); color: var(--on-ink); margin: 0 11.538rpx; }
.tabbar nav button.write span { display: none; }
.tabbar.hide-m { display: none; }
.tabbar .badge-dot { position: absolute; top: 15.385rpx; right: calc(50% - 30.769rpx); width: 15.385rpx; height: 15.385rpx; border-radius: 7.692rpx; background: var(--ink); }

/* ── 二级页面（从底部升起的面板） ── */
.sheet {
  position: fixed; inset: 0; z-index: 20; background: var(--bg); overflow-y: auto; -webkit-overflow-scrolling: touch;
}
.sheet.enter { animation: sheetin .28s cubic-bezier(.2,.8,.2,1); }
@keyframes sheetin { from { transform: translateY(76.923rpx); opacity: 0 } to { transform: none; opacity: 1 } }
/* 顶栏和页面同色，跟状态栏连成一片；内容滚上来时半透明模糊 */
.sheet-bar { position: sticky; top: 0; z-index: 40; background: var(--bg); padding-top: var(--safe-top); }
.subpage-bar.sheet-bar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 40;
  background: var(--bg);
}
.sheet-bar > div { max-width: 1076.923rpx; margin: 0 auto; height: 100rpx; display: flex; align-items: center; justify-content: space-between; gap: 15.385rpx; padding: 0 30.769rpx; }
.sheet-bar .t { font-weight: 600; font-size: 32.692rpx; flex: 1; text-align: center; }
.sheet-bar .x { width: 65.385rpx; height: 65.385rpx; border-radius: 32.692rpx; border: none; background: var(--card); box-shadow: 0 1.923rpx 5.769rpx rgba(0,0,0,.08); color: var(--sub); display: grid; place-items: center; padding: 0; flex: none; }
.sheet-bar .sp { width: 65.385rpx; flex: none; }
.sheet .page { padding-top: 15.385rpx; padding-bottom: calc(var(--safe-bottom) + 76.923rpx); min-height: 0; }

/* ── 表单 ── */
.field { display: flex; flex-direction: column; gap: 15.385rpx; margin-top: 42.308rpx; }
.field label, .field .lab { font-size: 25rpx; font-weight: 600; color: var(--sub); padding: 0 7.692rpx; }
.input {
  width: 100%; min-height: 92.308rpx; border: none; border-radius: var(--r-sm); background: var(--card);
  padding: 23.077rpx 26.923rpx; font-size: 32.692rpx; outline: none;
}
textarea.input { line-height: 1.6; resize: vertical; }
.group { background: var(--card); border-radius: var(--r-sm); }
.group .row { padding: 0 26.923rpx; }
.opts { display: flex; flex-direction: column; }
.opt { display: flex; align-items: center; gap: 23.077rpx; min-height: 100rpx; padding: 0 26.923rpx; border: none; background: none; text-align: left; width: 100%; font-size: 30.769rpx; }
.opt + .opt { border-top: 0.962rpx solid var(--sep); }
.opt small { display: block; font-size: 23.077rpx; color: var(--sub); }
.opt .tick { margin-left: auto; color: var(--ink); visibility: hidden; }
.opt[aria-pressed="true"] .tick { visibility: visible; }
.themes { display: flex; flex-wrap: wrap; gap: 19.231rpx; width: 100%; }
.theme-opt { border: 3.846rpx solid transparent; border-radius: 26.923rpx; padding: 11.538rpx; background: var(--card); display: flex; flex-direction: column; gap: 11.538rpx; align-items: stretch; font-size: 25rpx; width: calc((100% - 38.462rpx) / 3); box-sizing: border-box; }
.theme-opt[aria-pressed="true"] { border-color: var(--ink); font-weight: 600; }
.swatch { width: 100%; height: 107.692rpx; border-radius: 17.308rpx; display: flex; flex-direction: column; justify-content: flex-end; padding: 15.385rpx; gap: 7.692rpx; border: 0.962rpx solid rgba(0,0,0,.08); box-sizing: border-box; overflow: hidden; }
.swatch i { height: 7.692rpx; border-radius: 3.846rpx; display: block; }

/* ── 登录 ── */
.login { max-width: 769.231rpx; margin: 0 auto; min-height: 100vh; padding: calc(var(--safe-top) + 16vh) 46.154rpx 76.923rpx; display: flex; flex-direction: column; }
.login .logo { width: 138.462rpx; height: 138.462rpx; border-radius: 34.615rpx; background: var(--ink); color: var(--on-ink); display: grid; place-items: center; font-size: 50rpx; font-weight: 700; letter-spacing: -1.923rpx; }
.login h1 { margin-top: 34.615rpx; }
.login p { color: var(--sub); margin: 15.385rpx 0 50rpx; }
.login .btn { margin-top: 46.154rpx; }
.login .msg { margin-top: 26.923rpx; color: var(--danger); font-size: 26.923rpx; min-height: 38.462rpx; }

/* ── 提示 ── */
.toast {
  position: fixed; left: 50%; bottom: calc(var(--safe-bottom) + 184.615rpx); transform: translate(-50%, 23.077rpx);
  background: var(--text); color: var(--bg); border-radius: 38.462rpx; padding: 19.231rpx 34.615rpx; font-size: 26.923rpx;
  opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 50; max-width: 86vw; text-align: center;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.toast.has-act { pointer-events: auto; display: flex; align-items: center; gap: 26.923rpx; padding: 11.538rpx 11.538rpx 11.538rpx 34.615rpx; white-space: nowrap; }
.toast:not(.show) { pointer-events: none; }
.toast-act { border: none; border-radius: 30.769rpx; background: var(--ink); color: var(--on-ink); font-size: 26.923rpx; font-weight: 600; padding: 13.462rpx 26.923rpx; }
.chips.wrap { flex-wrap: wrap; overflow: visible; }
.fold { text-align: center; margin: 34.615rpx 0 15.385rpx; }
.mini-seg { display: inline-flex; gap: 7.692rpx; margin: 30.769rpx 0 7.692rpx; padding: 5.769rpx; border-radius: 23.077rpx; background: var(--tile); }
.mini-seg button { border: none; background: none; border-radius: 17.308rpx; padding: 11.538rpx 26.923rpx; font-size: 26.923rpx; color: var(--sub); }
.mini-seg button[aria-selected="true"] { background: var(--card); color: var(--text); font-weight: 600; box-shadow: 0 1.923rpx 5.769rpx rgba(0,0,0,.08); }
.card.grp { margin-top: 23.077rpx; padding: 0; overflow: hidden; }
.grp-h { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 26.923rpx 30.769rpx; border: none; background: none; color: var(--text); font-size: 28.846rpx; font-weight: 600; text-align: left; }
.grp-n { font-size: 25rpx; font-weight: 400; color: var(--sub); display: flex; align-items: center; gap: 11.538rpx; }
.grp-chev { font-style: normal; display: inline-block; transform: rotate(90deg); transition: transform .15s; }
.grp-chev.up { transform: rotate(-90deg); }
.row.hist { min-height: 92.308rpx; border-top: 0.962rpx solid var(--sep); }
.row.hist .row-main { padding: 15.385rpx 0; }
.row.hist .row-main > span:first-child { color: var(--sub); }
.hist-d { font-size: 23.077rpx; color: var(--sub); flex: none; font-variant-numeric: tabular-nums; }
.fold .lk { font-size: 25rpx; padding: 15.385rpx 23.077rpx; }
.ic.dim { opacity: .5; }
.drop-what { font-size: 32.692rpx; font-weight: 600; margin: 7.692rpx 0 34.615rpx; }
.offline { margin: 19.231rpx 7.692rpx 0; font-size: 23.077rpx; color: var(--sub); display: flex; align-items: center; gap: 11.538rpx; }
.offline[hidden] { display: none; }
.offline::before { content: ""; width: 11.538rpx; height: 11.538rpx; border-radius: 5.769rpx; background: var(--ring); }

/* ── 手机上不显示的东西 ── */
.tabbar .brand, .tabbar .side-set, .sheet-dim { display: none; }

/* ── 电脑版：左侧导航，内容居中 ── */
@media (prefers-reduced-motion: reduce) {
  .sheet, .bob, .reply-letter, .pop, .fresh, .sent .env-wrap, .sent .pm, .spin, .mic.on { animation: none; }
  button:active:not(:disabled), .tap:active { transform: none; }
}

/* ── 小程序补充：按钮默认样式、图标、信封、图表。视觉变量仍来自上面四套外观 ── */
button {
  padding: 0; margin: 0; background-color: transparent; line-height: inherit;
  font-size: inherit; font-weight: inherit; text-align: inherit; box-sizing: border-box;
}
button::after { display: none; border: none; }
.screen {
  min-height: 100vh; background: var(--bg); color: var(--text);
  font-family: var(--sans); font-size: 32.692rpx; line-height: 1.45;
}
.ck .box {
  width: 50rpx; height: 50rpx; border-radius: var(--check); border: 3.846rpx solid var(--ring);
  display: flex; align-items: center; justify-content: center; box-sizing: border-box;
}
.ck.on .box { background: var(--ink); border-color: var(--ink); }
.ck .tick, .hb .tick {
  width: 15.385rpx; height: 9.615rpx; border-left: 3.846rpx solid var(--on-ink); border-bottom: 3.846rpx solid var(--on-ink);
  transform: rotate(-45deg); margin-top: -3.846rpx; box-sizing: border-box;
}
.hb .tick { border-color: currentColor; }
